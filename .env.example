# Copy to .env and fill in for local development
DATABASE_URL=postgres://app:devpassword@localhost:5432/retailshop
TEST_DATABASE_URL=postgres://app:devpassword@localhost:5432/retailshop_test
POSTGRES_PORT=5432
SESSION_SECRET=replace-with-a-unique-random-secret-of-at-least-32-characters
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=replace-with-a-strong-owner-password
NODE_ENV=development
